# Copy to .env. Only needed for `python run.py --live`; --replay needs no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent under test
SVD_PROVIDER=openai          # openai | anthropic
SVD_MODEL=gpt-6-luna
# SVD_REASONING_EFFORT=      # OpenAI only; empty = model default

# Judge and R3 claim extractor
SVD_EVAL_PROVIDER=openai
SVD_EVAL_MODEL=gpt-6-luna
