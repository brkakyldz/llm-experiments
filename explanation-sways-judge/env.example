# Only needed for `python run.py --live`; --replay and the viewer need nothing.

# openai: a standard OpenAI API key client.
# siwc: the author's ChatGPT-subscription client, which is not part of this repo;
#       SIWC_CLIENT_PATH points to its local folder.
LLMX_BACKEND=openai
OPENAI_API_KEY=
# SIWC_CLIENT_PATH=

# The judge under test
SWAYED_JUDGE_MODEL=gpt-6-luna
SWAYED_JUDGE_EFFORT=low

# The second-model check (labels and grades)
SWAYED_CHECK_MODEL=gpt-6-sol
SWAYED_CHECK_EFFORT=medium
